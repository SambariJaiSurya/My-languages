// Example 04: Loops in MAZ
// Rule 7: Three-part loop separated by commas, 'new' creates loop-local variable

displayl("--- Loop 1: For loop with 'new' clause ---")
for (new i = 1, i <= 5, i++) {
    displayl("Iteration i = " + i)
}

displayl("\n--- Loop 2: Variable shadowing with 'new' ---")
k = 999
displayl("Before loop, outer k = " + k)

for (new k = 0, k < 3, k++) {
    displayl("Inside loop, local k = " + k)
}

displayl("After loop, outer k remains unchanged = " + k)

displayl("\n--- Loop 3: While Loop ---")
count = 3
while (count > 0) {
    displayl("Countdown: " + count)
    count--
}
displayl("Blast off!")
