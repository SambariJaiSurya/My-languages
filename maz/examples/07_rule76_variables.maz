// Testing Rule 76 Variable Declarations, Scoping and Shadowing

displayl("=== Test 1: Explicit Declarations & Multiple Declarations ===")
int a = 10, b = 20, c = 30
displayl("a = " + a + " b = " + b + " c = " + c)

int p = 100, q, r = 300
q = 200
displayl("p = " + p + " q = " + q + " r = " + r)

string name = "Surya"
float height = 175.5
bool isStudent = true
displayl("name: " + name + " height: " + height + " isStudent: " + isStudent)

displayl("=== Test 2: Delayed Assignment ===")
int delayedVar
delayedVar = 999
displayl("delayedVar = " + delayedVar)

displayl("=== Test 3: Block Scoping & Shadowing with new ===")
int score = 10
if (true) {
    displayl("Outer score inside if: " + score)
    score = 50
    displayl("Updated outer score: " + score)

    new score = 100
    displayl("Shadowed score with new: " + score)
}
displayl("Outer score after if block: " + score)

displayl("=== Test 4: Explicit Global Access inside Functions ===")
int count = 0

def increase() {
    global count
    count = count + 1
}

increase()
increase()
displayl("Count after two increases: " + count)

displayl("=== Test 5: dyn and force ===")
dyn dynamicVar = 100
displayl("dyn as int: " + dynamicVar)
dynamicVar = "Now string"
displayl("dyn as string: " + dynamicVar)

int fixedVal = 50
force fixedVal = "Forced string"
displayl("force retyped fixedVal: " + fixedVal)

displayl("=== All Rule 76 Tests Passed Successfully! ===")
