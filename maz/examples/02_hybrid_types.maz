// Example 02: Hybrid Type System in MAZ
// Rule 1: Type inference and const
// Rule 9: dyn and force for type mutation

display("--- Test 1: Inferred Types ---")
count = 42
display("Initial count: " + count)
count = 100
display("Updated count: " + count)

display("\n--- Test 2: Dynamic Variables with 'dyn' ---")
dyn flexible = 123
display("flexible as int: " + flexible)
flexible = "Now I am a string!"
display("flexible as string: " + flexible)
flexible = true
display("flexible as bool: " + flexible)

display("\n--- Test 3: Forced Re-typing with 'force' ---")
score = 99
display("score as int: " + score)
force score = "Excellent (Grade: A+)"
display("score after force: " + score)

display("\n--- Test 4: Constants with 'const' ---")
const MAX_USERS = 500
display("Constant MAX_USERS: " + MAX_USERS)

