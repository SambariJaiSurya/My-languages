// Example 02: Hybrid Type System in MAZ
// Rule 1: Type inference and const
// Rule 9: dyn and force for type mutation

displayl("--- Test 1: Inferred Types ---")
count = 42
displayl("Initial count: " + count)
count = 100
displayl("Updated count: " + count)

displayl("\n--- Test 2: Dynamic Variables with 'dyn' ---")
dyn flexible = 123
displayl("flexible as int: " + flexible)
flexible = "Now I am a string!"
displayl("flexible as string: " + flexible)
flexible = true
displayl("flexible as bool: " + flexible)

displayl("\n--- Test 3: Forced Re-typing with 'force' ---")
score = 99
displayl("score as int: " + score)
force score = "Excellent (Grade: A+)"
displayl("score after force: " + score)

displayl("\n--- Test 4: Constants with 'const' ---")
const MAX_USERS = 500
displayl("Constant MAX_USERS: " + MAX_USERS)
