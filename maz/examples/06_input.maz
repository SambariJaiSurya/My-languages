// MAZ Example 06: Rule 73 - Built-in Input System

display("=== Testing MAZ Input System ===")

name = inputString("Enter your name: ")
display("Hello,", name)

age = inputInt("Enter your age: ")
display("In 5 years, you will be:", age + 5)

height = inputFloat("Enter your height: ")
display("Your height is:", height)

isStudent = inputBool("Are you a student? (true/false): ")
if (isStudent) {
    display("Status: Active Student")
} else {
    display("Status: Not a Student")
}

data = input("Enter anything: ")
display("Raw input was:", data)

display("=== All Input System tests completed! ===")
