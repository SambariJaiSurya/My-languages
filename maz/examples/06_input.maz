// MAZ Example 06: Rule 73 - Built-in Input System (lowercase)

displayl("=== Testing MAZ Input System ===")

name = inputstring("Enter your name: ")
displayl("Hello, " + name)

age = inputint("Enter your age: ")
displayl("In 5 years, you will be: " + (age + 5))

height = inputfloat("Enter your height: ")
displayl("Your height is: " + height)

isStudent = inputbool("Are you a student? (true/false): ")
if (isStudent) {
    displayl("Status: Active Student")
} else {
    displayl("Status: Not a Student")
}

data = input("Enter anything: ")
displayl("Raw input was: " + data)

displayl("=== All Input System tests completed! ===")
