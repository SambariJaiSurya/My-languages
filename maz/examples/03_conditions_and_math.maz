// Example 03: Conditions, Arithmetic and Increment
// Rule 6: C++ style conditions
// Rule 13: Mathematical operators
// Rule 51: ++ and -- operators

displayl("--- Math Operations ---")
a = 25
b = 4

displayl("a + b = " + (a + b))
displayl("a - b = " + (a - b))
displayl("a * b = " + (a * b))
displayl("a / b = " + (a / b))
displayl("a % b = " + (a % b))

displayl("\n--- Increment & Decrement ---")
x = 10
displayl("Initial x: " + x)
x++
displayl("After x++: " + x)
++x
displayl("After ++x: " + x)
x--
displayl("After x--: " + x)

displayl("\n--- Conditions: if / else if / else ---")
grade = 85

if (grade >= 90) {
    displayl("Performance: Outstanding (A)")
} else if (grade >= 80) {
    displayl("Performance: Very Good (B)")
} else if (grade >= 70) {
    displayl("Performance: Good (C)")
} else {
    displayl("Performance: Needs Improvement")
}

displayl("\n--- Logical Operators ---")
hasTicket = true
age = 20

if (hasTicket && age >= 18) {
    displayl("Access granted: Adult with ticket.")
} else {
    displayl("Access denied.")
}
