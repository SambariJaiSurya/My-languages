// MAZ Example 08: Standard Mathematical Library Showcase

displayl("=== 1. Basic Functions & Constants ===")
displayl("PI = " + PI)
displayl("E = " + E)
displayl("abs(-42) = " + abs(-42))
displayl("min(5, 8) = " + min(5, 8))
displayl("max(5, 8) = " + max(5, 8))
displayl("pow(2, 5) = " + pow(2, 5))
displayl("sqrt(144) = " + sqrt(144))
displayl("cbrt(27) = " + cbrt(27))
displayl("hypot(3, 4) = " + hypot(3, 4))
displayl("clamp(15, 0, 10) = " + clamp(15, 0, 10))

displayl("=== 2. Rounding & Conversion ===")
displayl("round(4.7) = " + round(4.7))
displayl("floor(4.9) = " + floor(4.9))
displayl("ceil(4.1) = " + ceil(4.1))
displayl("trunc(4.9) = " + trunc(4.9))
displayl("round_to(3.14159, 2) = " + round_to(3.14159, 2))
displayl("is_integer(5.0) = " + is_integer(5.0))
displayl("is_integer(5.25) = " + is_integer(5.25))

displayl("=== 3. Trigonometry ===")
float angleDeg = 90.0
float angleRad = radians(angleDeg)
displayl("sin(radians(90)) = " + sin(angleRad))
displayl("cos(radians(0)) = " + cos(radians(0.0)))
displayl("degrees(PI) = " + degrees(PI))

displayl("=== 4. Logarithms & Exponentials ===")
displayl("exp(2) = " + exp(2.0))
displayl("log10(100) = " + log10(100.0))
displayl("log2(256) = " + log2(256.0))

displayl("=== 5. Number Theory & Combinatorics ===")
displayl("gcd(48, 18) = " + gcd(48, 18))
displayl("lcm(12, 18) = " + lcm(12, 18))
displayl("factorial(5) = " + factorial(5))
displayl("is_prime(29) = " + is_prime(29))
displayl("is_prime(30) = " + is_prime(30))
displayl("fibonacci(10) = " + fibonacci(10))
displayl("nCr(5, 2) = " + nCr(5, 2))
displayl("nPr(5, 2) = " + nPr(5, 2))
displayl("mod_pow(3, 4, 5) = " + mod_pow(3, 4, 5))

displayl("=== 6. Bitwise Mathematics ===")
displayl("popcount(29) = " + popcount(29)) // 29 = 11101 in binary -> 4 set bits

displayl("=== All Math Tests Executed Successfully! ===")
