// Example 01: Hello World & Fundamentals in MAZ
// Rule 1: Type inference by default, no 'let' required
// Rule 5: display() stays on same line, displayl() moves to next line
// Rule 15: String concatenation using +
// Rule 16: // and /* */ comments

displayl("========================================")
displayl(" Welcome to MAZ — Programming Language ")
displayl("========================================")

message = "Hello, World from MAZ!"
language = "MAZ"
version = 0.1

displayl(message)
displayl("Language: " + language + ", Version: " + version)

/* Multi-line comment demonstration:
   MAZ supports clean, readable code with curly braces
   and semicolon-free statement separation.
*/

author = "Creator"
displayl("Happy coding, " + author + "!")
